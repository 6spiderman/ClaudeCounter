<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Deliberately plain net8.0, not net8.0-windows: this project holds the
      polling loop, OAuth flow, usage models, settings model and alert state
      machine shared by every UI front end (WinForms today, an Avalonia Linux
      build later), plus the backup config, health and restore engine shared
      with the ClaudeBackup worker. Anything that needs a Windows-only API
      (DPAPI, the registry, GDI+) belongs in the front-end project instead,
      behind a seam already defined here (IDataProtector, ISessionStore, ...).
      The one exception is SyncFolderScanner's mapped-drive lookup, which
      reads the registry behind [SupportedOSPlatform("windows")].
    -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>ClaudeCounter.Core</AssemblyName>
  </PropertyGroup>

</Project>
