<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit" Version="2.7.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.7" />
  </ItemGroup>

  <ItemGroup>
    <!-- The WinForms-specific pieces (Shell, IconRenderer, ...) still tested here. -->
    <ProjectReference Include="..\..\src\ClaudeCounter\ClaudeCounter.csproj" />
    <!-- Explicit, not just transitive via the above, since most tests here exercise Core. -->
    <ProjectReference Include="..\..\src\ClaudeCounter.Core\ClaudeCounter.Core.csproj" />
    <!--
      Aliased: ClaudeBackup links the same Core\Log.cs source as ClaudeCounter,
      so both assemblies define ClaudeCounter.Core.Log. Without an alias, that
      type becomes ambiguous for every test file that does "using
      ClaudeCounter.Core;" and references Log unqualified. The alias keeps
      ClaudeBackup's types out of global lookup; BackupConfigTests.cs opts in
      explicitly via "extern alias".
    -->
    <ProjectReference Include="..\..\src\ClaudeBackup\ClaudeBackup.csproj">
      <Aliases>ClaudeBackupLib</Aliases>
    </ProjectReference>
  </ItemGroup>

</Project>
