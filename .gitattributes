# Normalise line endings so a contributor on another platform does not produce
# a diff that touches every line of every file.
* text=auto

# Windows-only tooling that must keep CRLF in the working tree.
*.ps1   text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf
*.iss   text eol=crlf
*.sln   text eol=crlf

*.cs      text diff=csharp
*.csproj  text
*.props   text
*.md      text
*.yml     text
*.yaml    text
*.json    text
*.svg     text

# Never touched.
*.png binary
*.ico binary
*.zip binary
*.exe binary
